name: "phikon"
backend: "python"
max_batch_size: 128

input [
  {
    name: "input_0"
    data_type: TYPE_UINT8
    dims: [224, 224,3]
  }
]

output [
  {
    name: "output_0"
    data_type: TYPE_FP32
    dims: [768]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0,1,2,3,4,5,6]
  }
]


